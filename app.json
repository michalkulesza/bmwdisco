{
  "expo": {
    "name": "BimmerDisco",
    "slug": "bimmerdisco",
    "version": "0.1.0",
    "scheme": "bimmerdisco",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "com.michalkulesza.bimmerdisco",
      "supportsTablet": false,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "BimmerDisco connects to your Bluetooth OBD adapter to control the lights of your car.",
        "NSLocalNetworkUsageDescription": "BimmerDisco connects to your ENET or Wi-Fi OBD adapter on the local network to control the lights of your car."
      }
    },
    "android": {
      "package": "com.michalkulesza.bimmerdisco",
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Geist-Regular.ttf",
            "./assets/fonts/Geist-Medium.ttf",
            "./assets/fonts/Geist-SemiBold.ttf",
            "./assets/fonts/Geist-Bold.ttf",
            "./assets/fonts/GeistMono-Regular.ttf"
          ]
        }
      ],
      "expo-localization",
      "expo-sqlite",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "BimmerDisco connects to your Bluetooth OBD adapter to control the lights of your car."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
