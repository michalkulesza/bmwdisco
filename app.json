{
  "expo": {
    "name": "BimmerDisco",
    "slug": "bimmerdisco",
    "version": "0.1.0",
    "scheme": "bimmerdisco",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "com.michalkulesza.bimmerdisco",
      "supportsTablet": false
    },
    "android": {
      "package": "com.michalkulesza.bimmerdisco"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Geist-Regular.ttf",
            "./assets/fonts/Geist-Medium.ttf",
            "./assets/fonts/Geist-SemiBold.ttf",
            "./assets/fonts/Geist-Bold.ttf",
            "./assets/fonts/GeistMono-Regular.ttf"
          ]
        }
      ],
      "expo-localization",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
