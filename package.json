{
  "name": "bimmerdisco",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "SENTRY_DISABLE_AUTO_UPLOAD=true expo run:ios",
    "ios:local": "SENTRY_DISABLE_AUTO_UPLOAD=true expo run:ios",
    "ios:release": "expo run:ios --configuration Release --device",
    "android": "SENTRY_DISABLE_AUTO_UPLOAD=true expo run:android",
    "android:release": "expo run:android --variant release",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "gen:data": "tsx scripts/gen-data.ts",
    "gen:data:check": "tsx scripts/gen-data.ts --check",
    "sync:data": "tsx scripts/sync-ecu-data.ts",
    "prepare": "husky",
    "e2e:ios": "maestro test --test-output-dir e2e/output e2e/demo-connect.yaml e2e/screens-tour.yaml"
  },
  "dependencies": {
    "@gluestack-ui/core": "^5.0.15",
    "@gluestack-ui/utils": "^5.0.6",
    "@sentry/react-native": "~7.11.0",
    "@shopify/react-native-skia": "2.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@xstate/react": "^6.1.0",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "expo": "~57.0.28",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.26",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "i18next": "^26.4.4",
    "nativewind": "5.0.0-rc.0",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.16",
    "react-native": "0.86.3",
    "react-native-ble-plx": "^3.5.1",
    "react-native-css": "3.1.0-rc.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-reorderable-list": "^0.18.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-tcp-socket": "^6.4.3",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4",
    "xstate": "^5.33.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.6",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "react-test-renderer": "^19.2.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-tcp-socket"
        ]
      }
    }
  }
}
