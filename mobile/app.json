{
  "expo": {
    "name": "BimmerDisco",
    "slug": "bimmerdisco",
    "version": "0.1.0",
    "scheme": "bimmerdisco",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kules.bimmerdisco",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to your BMW through an ENET Ethernet or THOR Wi-Fi adapter to identify its lighting controller and test front indicators."
      }
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sharing",
      "expo-sqlite"
    ]
  }
}
